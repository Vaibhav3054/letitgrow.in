# Optional: Configure these in Netlify UI (Site configuration > Environment variables)
# Scope: Functions (do NOT commit real keys into git)

# Your Resend API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx

# Verified sender address in Resend (e.g. "Let It Grow <hello@letitgrow.in>" after DNS verification)
# While testing before domain verification, you can use "Let It Grow <onboarding@resend.dev>"
RESEND_FROM_EMAIL=Let It Grow <hello@letitgrow.in>

# Destination inbox where you want lead notifications delivered
LEAD_TO_EMAIL=letitgrow.help@gmail.com
